{
  // Compiles the unit tests and the pure modules they import for `node --test`.
  // Only runtime-agnostic code (parsing, hashing, the session cache) is tested
  // here; the Worker entrypoint needs workerd and is exercised with `wrangler dev`.
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist-test",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.test.ts"]
}
