{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kt-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Required by @cloudflare/workers-oauth-provider when it fetches Client ID
  // Metadata Documents (Claude's "Use Claude's published identity" option).
  // kaloricketabulky.cz is a public host, so the flag costs nothing here.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // Create both namespaces with `wrangler kv namespace create <BINDING>` and
  // paste the ids it prints. See README → Setup.
  "kv_namespaces": [
    { "binding": "KT_SESSION", "id": "92f9f258b99b441ba66b553c117e16f3" },
    { "binding": "OAUTH_KV", "id": "ca4e71fe4ff748b6b0c93950a61e9286" }
  ],

  // Slows down passphrase guessing and registration spam on /authorize,
  // /register and /token: 10 requests per minute per client IP, per Cloudflare
  // location. OAuth mode refuses to run without it; to override that, add
  //   "vars": { "ALLOW_UNLIMITED_CONSENT_ATTEMPTS": "true" }
  // and accept that the consent page can then be brute-forced.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]

  // Secrets (never here): KT_EMAIL, KT_PASSWORD, MCP_AUTH_PASSWORD and/or
  // MCP_AUTH_TOKEN via `wrangler secret put NAME`; .dev.vars for `wrangler dev`.
}
